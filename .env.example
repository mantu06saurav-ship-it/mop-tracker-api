# Auth
JWT_SECRET=                    # required in production, no default should be relied on
JWT_EXPIRES_MINUTES=480        # 8h, matches the Node app's session length

# Database (MSSQL — same server/schema the Node app uses)
DB_SERVER=
DB_PORT=1433
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_ODBC_DRIVER=ODBC Driver 17 for SQL Server

# SMTP
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=MOP Tracker

# CORS — comma-separated list of allowed Next.js origins
CORS_ORIGINS=http://localhost:3000

PORT=8000
